# No Tenor API key is required or used by this project.
# This app scrapes Tenor's public search pages only.

# Optional overrides (all have sane defaults in code):

# Max results returned per search (default: 20)
TENOR_MAX_RESULTS=20

# Playwright navigation timeout in ms (default: 15000)
TENOR_PAGE_TIMEOUT=15000

# Cache TTL in ms (default: 300000 = 5 minutes)
TENOR_CACHE_TTL_MS=300000

# Rate limit: requests allowed per IP per window (default: 10)
TENOR_RATE_LIMIT_MAX=10

# Rate limit window in ms (default: 60000 = 1 minute)
TENOR_RATE_LIMIT_WINDOW_MS=60000
